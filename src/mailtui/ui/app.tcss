Screen {
    background: #070b14;
    color: #dbeafe;
}

#topbar {
    height: 1;
    background: #0f1b33;
    color: #7dd3fc;
    padding: 0 1;
}

#main {
    height: 1fr;
}

#folders {
    width: 24;
    background: #0b1220;
    border: round #1e3a5f;
    padding: 1;
}

#messages {
    width: 1fr;
    background: #0b1220;
    border: round #1e3a5f;
    padding: 1;
}

#preview {
    display: none;
    width: 1fr;
    background: #0a101d;
    border: round #1e3a5f;
    padding: 1 2;
}

#preview-titlebar {
    height: 1;
}

#preview-titlebar .pane-title {
    margin-bottom: 0;
}

.preview-close {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    background: transparent;
    color: #94a3b8;
    padding: 0;
}

.preview-close:hover {
    color: #f87171;
    background: #1e293b;
}

.pane-title {
    color: #94a3b8;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#folder-tree, #message-list {
    height: 1fr;
    background: transparent;
}

#folder-tree {
    padding: 0;
}

#folder-tree > .tree--cursor {
    background: #1d4ed8;
    color: #ffffff;
    text-style: bold;
}

#folder-tree > .tree--guides {
    color: #1e3a5f;
}

#search {
    display: none;
    height: 1;
    border: none;
    background: #111a2e;
    color: #e2e8f0;
    padding: 0 1;
    margin-bottom: 1;
}

ListItem {
    height: 1;
    padding: 0 1;
}

ListItem.-highlight {
    background: #1d4ed8;
    color: #ffffff;
}

#preview-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#preview-meta {
    height: auto;
    margin-bottom: 1;
}

#attachment-list {
    height: auto;
    max-height: 8;
    background: transparent;
    margin-bottom: 1;
}

#attachment-list ListItem {
    height: 1;
    padding: 0 1;
}

#attachment-list ListItem.-highlight {
    background: #1d4ed8;
    color: #ffffff;
}

#preview-body {
    width: 1fr;
    height: auto;
    color: #cbd5e1;
}

#bottombar {
    height: 1;
    background: #0f1b33;
}

#keybar {
    height: 1;
    width: 1fr;
    background: transparent;
    color: #64748b;
    padding: 0 1;
}

#status {
    height: 1;
    width: auto;
    background: transparent;
    color: #94a3b8;
    padding: 0 1;
    text-align: right;
}

HelpScreen {
    align: center middle;
    background: #020617;
}

#help {
    width: 82%;
    height: 82%;
    background: #0b1220;
    border: round #38bdf8;
    padding: 1 2;
}

#help-title {
    color: #7dd3fc;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#help-scroll {
    height: 1fr;
}

#help-markdown {
    height: auto;
}

#help-footer {
    height: 1;
    color: #64748b;
    margin-top: 1;
}

AttachmentScreen, SaveAllAttachmentsScreen {
    align: center middle;
    background: #020617;
}

#attachment-box {
    width: 76%;
    height: 85%;
    max-height: 90%;
    background: #0b1220;
    border: round #38bdf8;
    padding: 1 2;
}

#attachment-title {
    color: #7dd3fc;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#attachment-meta,
#attachment-image-hint,
#attachment-save-label,
#attachment-path {
    height: auto;
    color: #94a3b8;
    margin-bottom: 1;
}

#attachment-image {
    width: 1fr;
    height: 1fr;
    min-height: 4;
    margin-bottom: 1;
}

#attachment-dir {
    height: 3;
    margin-bottom: 1;
}

#attachment-actions {
    height: 3;
    align-horizontal: right;
}

#attachment-actions Button {
    margin-left: 1;
}

ComposeScreen {
    align: center middle;
    background: #020617;
}

AccountsScreen, AddAccountScreen, ConfirmRemoveScreen {
    align: center middle;
    background: #020617;
}

#onboarding-wrap {
    height: 1fr;
    align: center middle;
}

#onboarding {
    width: 72%;
    height: auto;
    background: #0b1220;
    border: round #38bdf8;
    padding: 2 3;
}

#onboarding-title {
    color: #7dd3fc;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#onboarding-body {
    height: auto;
    color: #cbd5e1;
    margin-bottom: 1;
}

#onboarding-actions {
    height: 3;
    align-horizontal: right;
}

#onboarding-actions Button {
    margin-left: 1;
}

#compose {
    width: 76%;
    height: 85%;
    background: #0b1220;
    border: round #38bdf8;
    padding: 1 2;
}

#compose-title {
    color: #7dd3fc;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#compose Input {
    height: 1;
    border: none;
    background: #0b1220;
    color: #e2e8f0;
    margin-bottom: 0;
}

#compose-body {
    height: 1fr;
    border: tall #1e3a5f;
}

#compose-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#compose-actions Button {
    margin-left: 1;
}

#accounts {
    width: 76%;
    height: 70%;
    background: #0b1220;
    border: round #38bdf8;
    padding: 1 2;
}

#account-list {
    height: 1fr;
    background: transparent;
}

#accounts-hint {
    height: auto;
    color: #94a3b8;
    margin-bottom: 1;
}

#accounts-actions {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#accounts-actions Button {
    margin-left: 1;
}

#accounts-status {
    height: 1;
    color: #64748b;
}

#account-form-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#account-form {
    height: auto;
}

#account-form Input {
    height: 1;
    border: none;
    background: #0b1220;
    color: #e2e8f0;
}

#form-hint {
    height: auto;
    color: #94a3b8;
    margin-bottom: 1;
}

#form-error {
    height: auto;
    color: #f87171;
}

#confirm-box {
    width: 58;
    height: 12;
    background: #0b1220;
    border: round #f87171;
    padding: 1 2;
}

#confirm-message {
    height: auto;
    margin: 1 0;
}

#confirm-actions {
    height: 3;
    align-horizontal: right;
}

#confirm-actions Button {
    margin-left: 1;
}
